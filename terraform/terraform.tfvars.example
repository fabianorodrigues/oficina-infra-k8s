aws_region            = "us-east-1"
project_name          = "oficina"
environment           = "dev"
ecr_repository_name   = "oficina-api"
ecr_mutable_alias_tag = "latest"
ecr_force_delete      = false

remote_state_bucket = "CHANGE_ME_STATE_BUCKET"
remote_state_region = "us-east-1"
db_remote_state_key = "oficina-infra-db/dev/terraform.tfstate"

cluster_name         = "oficina-eks"
node_instance_types  = ["t3.medium"]
node_min_size        = 1
node_desired_size    = 1
node_max_size        = 2
eks_cluster_role_arn = "arn:aws:iam::<account-id>:role/<eks-cluster-role>"
eks_node_role_arn    = "arn:aws:iam::<account-id>:role/<eks-node-role>"
